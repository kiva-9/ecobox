{
  "name": "ecobox",
  "private": true,
  "version": "1.0.0",
  "description": "微境：人工生命生态箱 — 2D 人工生命生态模拟游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:long": "vitest run tests/longrun.test.ts",
    "sim:batch": "vite-node scripts/batch-sim.ts",
    "sim:bench": "vite-node scripts/bench.ts"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
